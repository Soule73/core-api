# Database
MONGODB_URI=mongodb://localhost:27017/datavise
MONGODB_NAME=customdash

# Session
SESSION_TTL_DAYS=7

# Encryption (AES-256-GCM) - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-hex-char-encryption-key-here-change-in-production

# Server
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis (Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
AI_MODEL=gpt-4o-mini

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=customdash-uploads
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Database seeder (development only)
SEED_ADMIN_EMAIL=admin@customdash.com
SEED_ADMIN_PASSWORD=change-me-in-env
